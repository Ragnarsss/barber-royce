# Copia este archivo a .env y completa los valores (cp .env.example .env).
# .env no se sube al repositorio. Reinicia `npm run dev` después de cambiarlo.
# En producción se definen en Vercel (Settings > Environment Variables).
# De dónde sacar cada valor: README.md, sección "De dónde sacar las variables".
# Todas son opcionales: sin ellas el sitio usa el contenido de respaldo y no carga analítica.

# --- Hoja de Google con el catálogo ---
# El sitio la lee al construir y otra vez en el navegador: estos datos son públicos (no dan acceso de edición).
# Identificador de publicación de la hoja (empieza con 2PACX-).
CONTENT_SHEET_ID=
# pestaña:gid de cada pestaña publicada como CSV, separadas por coma.
# Ejemplo: servicios:0,productos:123456,equipo:234567,preguntas:345678,textos:456789,negocio:567890,sucursales:678901
CONTENT_SHEET_GIDS=
# Tiempo máximo por pestaña, en milisegundos (por defecto 10000).
CONTENT_FETCH_TIMEOUT_MS=

# --- Analítica ---
# "true" activa Vercel Analytics (hay que habilitarlo antes en el panel de Vercel).
VITE_VERCEL_ANALYTICS=
# ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Activa el aviso de consentimiento.
VITE_GA_MEASUREMENT_ID=

# Importante: toda variable VITE_* queda dentro del JavaScript que descarga el navegador.
# Son públicas: nunca pongas un secreto en una.
